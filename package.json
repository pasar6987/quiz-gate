{
  "name": "quiz-gate",
  "version": "0.1.0",
  "private": true,
  "description": "A BYOK GitHub merge gate that verifies code understanding with configurable quizzes.",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:action && tsc --noEmit",
    "build:action": "node scripts/build-action.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.76",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.60",
    "@vercel/functions": "^3.9.5",
    "ai": "^7.0.93",
    "jose": "^6.2.12",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.5.0",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
