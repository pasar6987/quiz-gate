{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "dist/action/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/health" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/github/webhook", "destination": "/api/github/webhook" },
    { "source": "/github/attest", "destination": "/api/github/attest" }
  ]
}
